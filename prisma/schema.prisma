// =============================================================================
// Discipular SaaS — Schema multi-tenant
//
// REGRA DE OURO DESTE SCHEMA
// Todo modelo que guarda dado de igreja carrega `tenantId` como PRIMEIRA
// coluna de todo índice. Nenhuma consulta da aplicação toca esses modelos sem
// passar pelo cliente escopado (src/lib/db/tenant-client.ts), que injeta o
// filtro de tenant automaticamente. O banco reforça isso com RLS
// (prisma/migrations/*_rls/migration.sql) como segunda camada.
//
// Modelos SEM tenantId são, por definição, globais da plataforma:
//   Tenant, TenantDomain, User, Membership, Session, PasswordResetToken,
//   RateLimitBucket, PlatformAuditLog
// Qualquer modelo novo é tenant-scoped por padrão. Se não for, justifique aqui.
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

// =============================================================================
// PLATAFORMA (global — sem tenantId)
// =============================================================================

enum TenantStatus {
  TRIAL // avaliação, com data de expiração
  ATIVO
  SUSPENSO // inadimplência — site fica offline, painel bloqueado
  CANCELADO // agendado para exclusão
}

enum TenantPlan {
  ESSENCIAL
  CRESCIMENTO
  MULTISEDE
}

/// Uma igreja cliente do SaaS. É a raiz de todo isolamento de dados.
model Tenant {
  id String @id @default(cuid())

  /// Identificador curto usado no subdomínio da plataforma:
  /// `slug`.discipular.app. Imutável depois de criado.
  slug String @unique @db.VarChar(63)

  nome          String       @db.VarChar(160)
  razaoSocial   String?      @db.VarChar(200)
  cnpj          String?      @db.VarChar(18)
  status        TenantStatus @default(TRIAL)
  plano         TenantPlan   @default(ESSENCIAL)
  trialExpiraEm DateTime?

  /// Limites do plano, verificados na escrita. Impedem que um tenant
  /// consuma recurso desproporcional da VPS compartilhada.
  limiteUsuarios  Int @default(5)
  limitePessoas   Int @default(2000)
  limiteStorageMb Int @default(512)

  criadoEm     DateTime  @default(now())
  atualizadoEm DateTime  @updatedAt
  excluidoEm   DateTime?

  dominios            TenantDomain[]
  membros             Membership[]
  pessoas             Pessoa[]
  celulas             Celula[]
  campi               Campus[]
  agendas             AgendaItem[]
  cursos              Curso[]
  matriculas          Matricula[]
  pedidosOracao       PedidoOracao[]
  batismos            SolicitacaoBatismo[]
  submissoes          Submissao[]
  mensagens           Mensagem[]
  arquivos            Arquivo[]
  siteConfig          SiteConfig?
  sitePaginas         SitePagina[]
  liveConfig          LiveConfig?
  auditoria           AuditLog[]
  notificacoes        Notificacao[]
  whatsapp            WhatsappInstance?
  contasContabeis     ContaContabil[]
  lancamentosFin      LancamentoFinanceiro[]
  partidasFin         PartidaFinanceira[]
  fechamentosFin      FechamentoFinanceiro[]
  acessosFin          AcessoFinanceiro[]
  inscricoes          Inscricao[]
  inscricaoRespostas  InscricaoResposta[]
  criancas            Crianca[]
  criancaResponsaveis CriancaResponsavel[]
  salasKids           SalaKids[]
  sessoesKids         SessaoSalaKids[]
  qrTokensKids        QrTokenKids[]
  evolucoesKids       EvolucaoKids[]
  conquistasKids      ConquistaKids[]
  templatesMensagem   MensagemTemplate[]
  ministerios         Ministerio[]
  membrosMinisterio   MembroMinisterio[]
  funcoesMinisterio   FuncaoMinisterio[]
  membroFuncoes       MembroFuncao[]
  indisponibilidades  IndisponibilidadeMinisterio[]
  escalasMinisterio   EscalaMinisterio[]
  eventosEscala       EventoEscala[]
  escaladosEvento     EscaladoEvento[]
  musicasMinisterio   MusicaMinisterio[]
  eventoMusicas       EventoMusica[]
  chatMinisterio      ChatMinisterio[]
  configAppMembro     ConfiguracaoAppMembro?
  contribuicoes       Contribuicao[]
  configPagamento     ConfiguracaoPagamento?
  configModulos       ConfiguracaoModulos?

  @@index([status])
  @@map("tenants")
}

enum DomainStatus {
  PENDENTE // aguardando verificação de DNS
  VERIFICADO
  ERRO
}

/// Domínio próprio do cliente apontando para a plataforma.
/// É por aqui que o middleware descobre de qual igreja é a requisição.
model TenantDomain {
  id       String @id @default(cuid())
  tenantId String

  /// Hostname normalizado (minúsculo, sem porta, sem ponto final).
  /// UNIQUE GLOBAL: um domínio jamais pode resolver para dois tenants.
  hostname String @unique @db.VarChar(253)

  /// Domínio principal do tenant — usado para gerar links canônicos,
  /// e-mails e o manifest do PWA. Exatamente um por tenant.
  principal Boolean @default(false)

  status DomainStatus @default(PENDENTE)

  /// Token que o cliente publica num registro TXT `_discipular.<dominio>`
  /// para provar que controla o domínio. Sem isso, qualquer um poderia
  /// reivindicar o domínio de outra igreja.
  tokenVerificacao String    @db.VarChar(64)
  verificadoEm     DateTime?
  ultimoErro       String?   @db.VarChar(500)

  criadoEm DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, principal])
  @@index([status])
  @@map("tenant_domains")
}

/// Conta de acesso. Global: a mesma pessoa pode pastorear duas igrejas.
/// O vínculo com igreja e o papel ficam em `Membership`.
model User {
  id String @id @default(cuid())

  email             String    @unique @db.VarChar(254)
  emailVerificadoEm DateTime?
  nome              String    @db.VarChar(160)
  telefone          String?   @db.VarChar(20)

  /// Formato: scrypt$N$r$p$<salt-b64>$<hash-b64>. Ver src/lib/auth/password.ts
  senhaHash         String   @db.VarChar(255)
  senhaAtualizadaEm DateTime @default(now())

  /// Administrador da PLATAFORMA (você). Enxerga todos os tenants.
  /// Fora do modelo de Membership de propósito: é um poder diferente.
  plataformaAdmin Boolean @default(false)

  ativo Boolean @default(true)

  /// Bloqueio progressivo contra força bruta.
  tentativasFalhas Int       @default(0)
  bloqueadoAte     DateTime?

  ultimoLoginEm DateTime?
  criadoEm      DateTime  @default(now())
  atualizadoEm  DateTime  @updatedAt

  memberships   Membership[]
  sessoes       Sessao[]
  tokensSenha   TokenSenha[]
  pessoaVinculo Pessoa[]

  @@index([plataformaAdmin])
  @@map("users")
}

enum Papel {
  /// Acesso total ao tenant, incluindo faturamento e exclusão de dados.
  ADMIN
  /// Gestão pastoral completa: pessoas, batismos, oração, células, site.
  PASTOR
  /// Secretaria: cadastros e triagem. Não mexe em usuários nem no site.
  SECRETARIA
  /// Líder de célula: enxerga APENAS a própria célula.
  LIDER_CELULA
  /// Membro comum: acessa o app, vê os próprios dados.
  MEMBRO
}

/// Vínculo usuário <-> igreja, com papel. É a fonte da verdade de autorização.
model Membership {
  id       String @id @default(cuid())
  tenantId String
  userId   String

  papel Papel   @default(MEMBRO)
  ativo Boolean @default(true)

  /// Para LIDER_CELULA: a célula que ele lidera. O RBAC usa isto para
  /// restringir a visão a essa célula.
  celulaId String?

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  tenant Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  celula Celula? @relation(fields: [celulaId], references: [id], onDelete: SetNull)

  /// Um usuário tem no máximo UM papel por igreja.
  @@unique([tenantId, userId])
  @@index([userId])
  @@index([tenantId, papel])
  @@map("memberships")
}

/// Sessão de login. Opaca e revogável — guardamos apenas o HASH do token.
/// Vazamento do banco não permite sequestrar sessão.
model Sessao {
  id String @id @default(cuid())

  /// HMAC-SHA256(token, SESSION_SECRET), em hex. O token em claro só existe
  /// no cookie do usuário; nunca é gravado em lugar nenhum.
  tokenHash String @unique @db.VarChar(64)

  userId String

  /// Igreja ativa nesta sessão. Trocar de igreja = revalidar Membership.
  /// Null para o super admin navegando na área da plataforma.
  tenantAtivoId String?

  /// Marca sessões abertas via "entrar como" do super admin. Toda ação
  /// feita nelas fica etiquetada na auditoria.
  impersonadoPor String?

  ipHash      String?   @db.VarChar(64)
  userAgent   String?   @db.VarChar(255)
  criadaEm    DateTime  @default(now())
  ultimoUsoEm DateTime  @default(now())
  expiraEm    DateTime
  revogadaEm  DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revogadaEm])
  @@index([expiraEm])
  @@map("sessoes")
}

/// Token de recuperação de senha. Também guardado só como hash, uso único.
model TokenSenha {
  id        String    @id @default(cuid())
  tokenHash String    @unique @db.VarChar(64)
  userId    String
  expiraEm  DateTime
  usadoEm   DateTime?
  criadoEm  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiraEm])
  @@map("tokens_senha")
}

/// Contador de rate limit persistido. Fica no banco (e não só em memória)
/// para funcionar com múltiplos processos Node atrás do Nginx.
model RateLimitBucket {
  /// Chave composta: "<escopo>:<identificador>", ex. "login:ip:<hash>".
  chave String @id @db.VarChar(160)

  contador  Int      @default(0)
  janelaFim DateTime

  /// Enquanto preenchido, todas as tentativas são recusadas de imediato.
  bloqueadoAte DateTime?

  @@index([janelaFim])
  @@map("rate_limit_buckets")
}

/// Auditoria de ações da PLATAFORMA (super admin). Separada da auditoria
/// por tenant para que um admin de igreja nunca a enxergue.
model PlatformAuditLog {
  id String @id @default(cuid())

  atorUserId String?  @db.VarChar(30)
  atorEmail  String?  @db.VarChar(254)
  acao       String   @db.VarChar(80)
  alvoTipo   String?  @db.VarChar(60)
  alvoId     String?  @db.VarChar(60)
  detalhes   Json?
  ipHash     String?  @db.VarChar(64)
  criadoEm   DateTime @default(now())

  @@index([criadoEm])
  @@index([atorUserId, criadoEm])
  @@map("platform_audit_logs")
}

// =============================================================================
// -----------------------------------------------------------------------------
// WhatsApp (uazapi) — 1 instância/número por igreja.
//
// tenantId é a PK: cada igreja tem no máximo uma conexão. O `uazToken` é a
// chave da instância na uazapi — SEGREDO, só o backend lê (nunca vai ao
// navegador). O Admin token da uazapi NÃO fica aqui: é global da plataforma,
// em variável de ambiente (UAZAPI_ADMIN_TOKEN).
// -----------------------------------------------------------------------------
model WhatsappInstance {
  tenantId String @id

  uazInstanceId String
  uazToken      String
  status        String    @default("desconectado") // desconectado | conectando | conectado
  numero        String?   @db.VarChar(20)
  perfilNome    String?   @db.VarChar(120)
  conectadoEm   DateTime?

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("whatsapp_instances")
}

// DADOS DA IGREJA (tenant-scoped — todos com tenantId)
// =============================================================================

enum StatusPessoa {
  VISITANTE
  EM_ACOMPANHAMENTO
  CONGREGANTE
  MEMBRO
  INATIVO
  TRANSFERIDO
}

enum Genero {
  MASCULINO
  FEMININO
  NAO_INFORMADO
}

enum EstadoCivil {
  SOLTEIRO
  CASADO
  DIVORCIADO
  VIUVO
  UNIAO_ESTAVEL
  NAO_INFORMADO
}

enum OrigemCadastro {
  SITE
  APP
  PAINEL
  IMPORTACAO
  CELULA
}

/// Registro único de pessoa. Visitante e membro são o MESMO registro em
/// estágios diferentes — evita duplicidade quando o visitante se torna membro.
model Pessoa {
  id       String @id @default(cuid())
  tenantId String

  nome           String      @db.VarChar(160)
  email          String?     @db.VarChar(254)
  telefone       String?     @db.VarChar(20)
  dataNascimento DateTime?   @db.Date
  genero         Genero      @default(NAO_INFORMADO)
  estadoCivil    EstadoCivil @default(NAO_INFORMADO)

  status StatusPessoa   @default(VISITANTE)
  origem OrigemCadastro @default(SITE)

  // Endereço
  cep         String? @db.VarChar(9)
  logradouro  String? @db.VarChar(200)
  numero      String? @db.VarChar(20)
  complemento String? @db.VarChar(100)
  bairro      String? @db.VarChar(100)
  cidade      String? @db.VarChar(100)
  uf          String? @db.VarChar(2)

  // Jornada de fé
  dataConversao  DateTime? @db.Date
  batizado       Boolean   @default(false)
  dataBatismo    DateTime? @db.Date
  igrejaAnterior String?   @db.VarChar(160)

  celulaId String?
  campusId String?

  /// Conta de acesso ao app, quando a pessoa se cadastra. Opcional:
  /// a maioria das pessoas existe no sistema sem nunca logar.
  userId String?

  /// Observações pastorais. Dado sensível: só PASTOR e ADMIN leem
  /// (filtrado na camada de serviço, ver src/lib/services/pessoas.ts).
  observacoesPastorais String? @db.Text

  /// Consentimento LGPD para tratamento dos dados e contato.
  consentimentoLgpd   Boolean   @default(false)
  consentimentoEm     DateTime?
  consentimentoOrigem String?   @db.VarChar(60)

  /// Marcadores das automações de relacionamento (nunca dispara duas vezes).
  boasVindasEm     DateTime?
  conviteRetornoEm DateTime?

  criadoEm     DateTime  @default(now())
  atualizadoEm DateTime  @updatedAt
  excluidoEm   DateTime?

  tenant        Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  celula        Celula?              @relation(fields: [celulaId], references: [id], onDelete: SetNull)
  campus        Campus?              @relation(fields: [campusId], references: [id], onDelete: SetNull)
  user          User?                @relation(fields: [userId], references: [id], onDelete: SetNull)
  batismos      SolicitacaoBatismo[]
  pedidosOracao PedidoOracao[]
  matriculas    Matricula[]
  interacoes    Interacao[]

  // Índices SEMPRE começando por tenantId: sem isso, o Postgres varreria
  // linhas de outras igrejas antes de aplicar o filtro.
  @@index([tenantId, status, criadoEm])
  @@index([tenantId, nome])
  @@index([tenantId, celulaId])
  @@index([tenantId, email])
  @@index([tenantId, excluidoEm])
  @@map("pessoas")
}

/// Histórico de contato pastoral com uma pessoa (ligação, visita, WhatsApp).
/// É o que transforma "cadastro" em "acompanhamento de verdade".
model Interacao {
  id       String @id @default(cuid())
  tenantId String
  pessoaId String

  tipo      String   @db.VarChar(40) // LIGACAO | VISITA | MENSAGEM | ORACAO | OUTRO
  descricao String   @db.Text
  autorId   String?  @db.VarChar(30)
  autorNome String?  @db.VarChar(160)
  criadoEm  DateTime @default(now())

  pessoa Pessoa @relation(fields: [pessoaId], references: [id], onDelete: Cascade)

  @@index([tenantId, pessoaId, criadoEm])
  @@map("interacoes")
}

enum StatusSubmissao {
  NOVO
  EM_ANALISE
  CONCLUIDO
  ARQUIVADO
  SPAM
}

enum TipoSubmissao {
  NOVO_MEMBRO
  VISITANTE
  BATISMO
  PEDIDO_ORACAO
  CONTATO
  INSCRICAO_CURSO
  QUERO_CELULA
  ACONSELHAMENTO
}

/// Caixa de entrada única de tudo que chega do site e do app.
/// Nada entra direto no cadastro definitivo: passa por triagem humana.
/// Isso evita que um bot polua a base de membros da igreja.
model Submissao {
  id       String @id @default(cuid())
  tenantId String

  tipo   TipoSubmissao
  status StatusSubmissao @default(NOVO)

  nome     String  @db.VarChar(160)
  email    String? @db.VarChar(254)
  telefone String? @db.VarChar(20)

  /// Campos específicos por tipo, validados por schema Zod antes de gravar
  /// (ver src/lib/validation/submissoes.ts). Nunca renderizar como HTML.
  dados Json

  origem       OrigemCadastro @default(SITE)
  paginaOrigem String?        @db.VarChar(200)

  /// Só o hash do IP, para não guardar dado pessoal desnecessário (LGPD)
  /// mantendo a capacidade de investigar abuso.
  ipHash    String? @db.VarChar(64)
  userAgent String? @db.VarChar(255)

  /// Pontuação do anti-spam (honeypot + tempo de preenchimento + heurísticas).
  scoreSpam Int @default(0)

  // Triagem
  responsavelId  String?   @db.VarChar(30)
  notaInterna    String?   @db.Text
  processadoEm   DateTime?
  /// Pessoa criada/vinculada quando a submissão foi aprovada.
  pessoaGeradaId String?   @db.VarChar(30)

  consentimentoLgpd Boolean @default(false)

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, status, criadoEm])
  @@index([tenantId, tipo, status])
  @@index([tenantId, criadoEm])
  @@map("submissoes")
}

enum StatusBatismo {
  SOLICITADO
  EM_PREPARO // fazendo o curso preparatório
  APROVADO
  AGENDADO
  REALIZADO
  RECUSADO
  CANCELADO
}

model SolicitacaoBatismo {
  id       String  @id @default(cuid())
  tenantId String
  pessoaId String?

  nome           String    @db.VarChar(160)
  email          String?   @db.VarChar(254)
  telefone       String?   @db.VarChar(20)
  dataNascimento DateTime? @db.Date

  status StatusBatismo @default(SOLICITADO)

  /// Perguntas do formulário de batismo (testemunho, já foi batizado antes,
  /// participa de célula, etc.). Estrutura validada por Zod.
  respostas Json?

  /// Menor de idade exige autorização do responsável — obrigatório por lei
  /// e checado na aprovação.
  menorIdade             Boolean @default(false)
  responsavelNome        String? @db.VarChar(160)
  responsavelTelefone    String? @db.VarChar(20)
  autorizacaoResponsavel Boolean @default(false)

  turmaPreparatoria String?   @db.VarChar(120)
  dataBatismo       DateTime?
  campusId          String?
  observacoes       String?   @db.Text
  motivoRecusa      String?   @db.VarChar(500)

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  tenant Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  pessoa Pessoa? @relation(fields: [pessoaId], references: [id], onDelete: SetNull)
  campus Campus? @relation(fields: [campusId], references: [id], onDelete: SetNull)

  @@index([tenantId, status, criadoEm])
  @@index([tenantId, dataBatismo])
  @@map("solicitacoes_batismo")
}

enum StatusOracao {
  RECEBIDO
  ORANDO
  RESPONDIDO
  ARQUIVADO
}

enum VisibilidadeOracao {
  /// Só a equipe pastoral vê. Padrão — é o mais seguro.
  PRIVADO
  /// Aparece no mural do app para os membros orarem juntos.
  MURAL_MEMBROS
  /// Aparece no site público (exige consentimento explícito).
  PUBLICO
}

/// Pedido de oração. Trata dado de saúde, família e crise — é a informação
/// mais sensível do sistema. Por isso: visibilidade padrão PRIVADO, opção de
/// anonimato, e leitura restrita por RBAC.
model PedidoOracao {
  id       String  @id @default(cuid())
  tenantId String
  pessoaId String?

  /// Preenchido quando o pedido é anônimo (não há pessoa vinculada).
  nomeSolicitante String? @db.VarChar(160)
  emailContato    String? @db.VarChar(254)
  telefoneContato String? @db.VarChar(20)

  anonimo Boolean @default(false)

  categoria String  @default("GERAL") @db.VarChar(40) // SAUDE | FAMILIA | FINANCEIRO | ESPIRITUAL | LUTO | GRATIDAO | GERAL
  titulo    String? @db.VarChar(160)
  pedido    String  @db.Text

  urgente      Boolean            @default(false)
  visibilidade VisibilidadeOracao @default(PRIVADO)
  status       StatusOracao       @default(RECEBIDO)

  /// Contador do botão "estou orando" no app. Não guarda quem clicou
  /// para não expor a rede de relacionamento de quem pediu.
  contadorOracoes Int @default(0)

  respostaTestemunho String?   @db.Text
  respondidoEm       DateTime?
  responsavelId      String?   @db.VarChar(30)

  origem OrigemCadastro @default(SITE)
  ipHash String?        @db.VarChar(64)

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  tenant Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  pessoa Pessoa? @relation(fields: [pessoaId], references: [id], onDelete: SetNull)

  @@index([tenantId, status, criadoEm])
  @@index([tenantId, visibilidade, status])
  @@index([tenantId, urgente, status])
  @@map("pedidos_oracao")
}

/// Endereço físico da igreja (sede, campus). O HTML de referência tem
/// "Sede Lajeado" e "Campus Vera Cruz".
model Campus {
  id       String @id @default(cuid())
  tenantId String

  nome      String  @db.VarChar(120)
  descricao String? @db.VarChar(255)

  cep         String? @db.VarChar(9)
  logradouro  String? @db.VarChar(200)
  numero      String? @db.VarChar(20)
  complemento String? @db.VarChar(100)
  bairro      String? @db.VarChar(100)
  cidade      String? @db.VarChar(100)
  uf          String? @db.VarChar(2)

  mapaEmbedUrl String? @db.VarChar(500)
  telefone     String? @db.VarChar(20)
  principal    Boolean @default(false)
  ordem        Int     @default(0)
  ativo        Boolean @default(true)

  criadoEm DateTime @default(now())

  tenant          Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  pessoas         Pessoa[]
  agenda          AgendaItem[]
  celulas         Celula[]
  batismos        SolicitacaoBatismo[]
  contasContabeis ContaContabil[]
  lancamentosFin  LancamentoFinanceiro[]
  contribuicoes   Contribuicao[]
  fechamentosFin  FechamentoFinanceiro[]
  acessosFin      AcessoFinanceiro[]

  @@index([tenantId, ativo, ordem])
  @@map("campi")
}

/// Célula / pequeno grupo.
model Celula {
  id       String  @id @default(cuid())
  tenantId String
  campusId String?

  nome      String  @db.VarChar(120)
  descricao String? @db.Text

  diaSemana Int?    @db.SmallInt // 0=domingo ... 6=sábado
  horario   String? @db.VarChar(5) // "20:00"

  liderNome     String? @db.VarChar(160)
  liderTelefone String? @db.VarChar(20)

  bairro String? @db.VarChar(100)
  cidade String? @db.VarChar(100)

  /// Coordenadas aproximadas para o mapa "encontre uma célula".
  /// Deliberadamente NÃO guardamos o endereço exato em campo público:
  /// é a casa de alguém. O endereço completo só vai por contato direto.
  latitude  Float?
  longitude Float?

  /// Quantas pessoas ainda cabem. Usado no app para sugerir células.
  capacidade Int?
  ativa      Boolean @default(true)

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  tenant    Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  campus    Campus?          @relation(fields: [campusId], references: [id], onDelete: SetNull)
  pessoas   Pessoa[]
  lideres   Membership[]
  encontros EncontroCelula[]

  @@index([tenantId, ativa])
  @@index([tenantId, cidade, bairro])
  @@map("celulas")
}

/// Relatório de encontro de célula — o líder registra pela app.
model EncontroCelula {
  id       String @id @default(cuid())
  tenantId String
  celulaId String

  data           DateTime @db.Date
  presentes      Int      @default(0)
  visitantes     Int      @default(0)
  decisoes       Int      @default(0)
  ofertaCentavos Int      @default(0)
  observacoes    String?  @db.Text

  registradoPorId String?  @db.VarChar(30)
  criadoEm        DateTime @default(now())

  celula Celula @relation(fields: [celulaId], references: [id], onDelete: Cascade)

  @@unique([celulaId, data])
  @@index([tenantId, data])
  @@map("encontros_celula")
}

enum TipoAgenda {
  CULTO
  ESCOLA
  CELULA
  EVENTO
  ENSAIO
  ORACAO
}

/// Agenda semanal / eventos. Alimenta o site e o app.
model AgendaItem {
  id       String  @id @default(cuid())
  tenantId String
  campusId String?

  tipo      TipoAgenda @default(CULTO)
  titulo    String     @db.VarChar(160)
  descricao String?    @db.Text

  /// Evento recorrente: dia da semana + horário.
  diaSemana Int?    @db.SmallInt
  horario   String? @db.VarChar(5)

  /// Evento pontual: data/hora exata. Um dos dois modos deve estar preenchido.
  dataHora DateTime?

  recorrente  Boolean @default(true)
  destaque    Boolean @default(false)
  ordem       Int     @default(0)
  ativo       Boolean @default(true)
  publicoSite Boolean @default(true)

  criadoEm DateTime @default(now())

  tenant Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  campus Campus? @relation(fields: [campusId], references: [id], onDelete: SetNull)

  @@index([tenantId, ativo, ordem])
  @@index([tenantId, dataHora])
  @@map("agenda_itens")
}

/// Curso da Escola (Teologia Discipular, Trilha Discipular...).
model Curso {
  id       String @id @default(cuid())
  tenantId String

  nome      String  @db.VarChar(160)
  slug      String  @db.VarChar(80)
  descricao String? @db.Text
  resumo    String? @db.VarChar(400)

  diaSemana Int?    @db.SmallInt
  horario   String? @db.VarChar(5)

  /// Em centavos, para nunca ter erro de arredondamento com float.
  precoCentavos Int?
  periodicidade String? @db.VarChar(20) // MENSAL | UNICO

  vagas             Int?
  inscricoesAbertas Boolean @default(true)
  ativo             Boolean @default(true)
  ordem             Int     @default(0)

  criadoEm DateTime @default(now())

  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  matriculas Matricula[]

  @@unique([tenantId, slug])
  @@index([tenantId, ativo, ordem])
  @@map("cursos")
}

enum StatusMatricula {
  INSCRITO
  CONFIRMADO
  CURSANDO
  CONCLUIDO
  CANCELADO
}

model Matricula {
  id       String  @id @default(cuid())
  tenantId String
  cursoId  String
  pessoaId String?

  nome     String  @db.VarChar(160)
  email    String? @db.VarChar(254)
  telefone String? @db.VarChar(20)

  status      StatusMatricula @default(INSCRITO)
  observacoes String?         @db.Text

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  tenant Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  curso  Curso   @relation(fields: [cursoId], references: [id], onDelete: Cascade)
  pessoa Pessoa? @relation(fields: [pessoaId], references: [id], onDelete: SetNull)

  @@index([tenantId, cursoId, status])
  @@index([tenantId, criadoEm])
  @@map("matriculas")
}

/// Mensagem / pregação publicada (vídeo do YouTube, série, etc.).
model Mensagem {
  id       String @id @default(cuid())
  tenantId String

  titulo    String  @db.VarChar(200)
  slug      String  @db.VarChar(120)
  descricao String? @db.Text
  preletor  String? @db.VarChar(160)
  serie     String? @db.VarChar(120)

  /// SOMENTE o ID do vídeo (11 caracteres), nunca a URL crua vinda do
  /// usuário — assim o `src` do iframe é sempre montado por nós.
  youtubeVideoId  String?   @db.VarChar(20)
  duracaoSegundos Int?
  data            DateTime? @db.Date

  capaArquivoId String?
  publicado     Boolean @default(false)
  destaque      Boolean @default(false)

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  tenant Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  capa   Arquivo? @relation(fields: [capaArquivoId], references: [id], onDelete: SetNull)

  @@unique([tenantId, slug])
  @@index([tenantId, publicado, data])
  @@map("mensagens")
}

// =============================================================================
// WHITELABEL — site editável pelo próprio cliente
// =============================================================================

/// Identidade visual e conteúdo global do site/app de uma igreja.
/// É o coração do whitelabel: trocar aqui muda site e PWA de uma vez.
model SiteConfig {
  id       String @id @default(cuid())
  tenantId String @unique

  // --- Marca
  nomeExibicao String  @db.VarChar(120)
  tagline      String? @db.VarChar(200)
  descricaoSeo String? @db.VarChar(300)

  logoClaroId  String? // logo para fundo escuro
  logoEscuroId String? // logo para fundo claro
  faviconId    String?
  ogImageId    String?

  // --- Cores. Guardadas como HEX e SEMPRE validadas com regex antes de
  // virarem CSS custom properties — senão seria injeção de CSS.
  // Ver src/lib/site/theme.ts
  corAcento      String @default("#34472F") @db.VarChar(9)
  corAcentoClara String @default("#8FBF7A") @db.VarChar(9)
  corTinta       String @default("#14161A") @db.VarChar(9)
  corPapel       String @default("#EEF0F2") @db.VarChar(9)

  fonteTitulo String @default("Archivo") @db.VarChar(60)
  fonteTexto  String @default("Inter") @db.VarChar(60)

  // --- Hero da home
  heroTitulo    String? @db.VarChar(200)
  heroSubtitulo String? @db.VarChar(400)
  heroEyebrow   String? @db.VarChar(80)
  heroImagemId  String?
  /// Imagem de fundo do site inteiro, exibida bem transparente atrás de tudo.
  fundoImagemId String?
  /// Fotos das seções (pastores). Preenchidas pelo painel; caem no lugar dos
  /// placeholders na home e na página Pastores.
  fotoPastorId  String?
  fotoPastoraId String?
  heroVideoUrl  String? @db.VarChar(500)
  heroCtaTexto  String? @db.VarChar(60)
  heroCtaLink   String? @db.VarChar(200)

  // --- Conteúdo editável da home (JSON validado no app). Ministérios e
  // depoimentos que aparecem na home Institucional; cada igreja edita o seu.
  ministeriosJson String? @db.Text
  depoimentosJson String? @db.Text

  // --- Contato
  emailContato    String? @db.VarChar(254)
  telefoneContato String? @db.VarChar(20)
  whatsapp        String? @db.VarChar(20)

  instagram String? @db.VarChar(200)
  facebook  String? @db.VarChar(200)
  youtube   String? @db.VarChar(200)
  spotify   String? @db.VarChar(200)

  // --- Contribuição
  pixChave                     String? @db.VarChar(200)
  pixTitular                   String? @db.VarChar(160)
  pixDescricao                 String? @db.Text
  /// Dados bancários. Criptografados em repouso (AES-256-GCM) porque são
  /// alvo óbvio para fraude de boleto/transferência.
  dadosBancariosCriptografados String? @db.Text

  // --- PWA
  pwaNome      String? @db.VarChar(60)
  pwaNomeCurto String? @db.VarChar(20)
  pwaIconeId   String?
  pwaCorTema   String  @default("#0B0D11") @db.VarChar(9)

  /// Liga/desliga módulos no site e no app por igreja.
  modulos Json @default("{}")

  atualizadoEm DateTime @updatedAt
  criadoEm     DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("site_configs")
}

/// Página do site. O conteúdo fica em `blocos` (JSON estruturado),
/// nunca em HTML cru — o cliente escolhe blocos prontos e preenche campos.
/// Essa decisão elimina a classe inteira de XSS armazenado via editor.
model SitePagina {
  id       String @id @default(cuid())
  tenantId String

  slug   String @db.VarChar(80) // "home", "quem-somos", "pastores"...
  titulo String @db.VarChar(160)

  seoTitulo    String? @db.VarChar(200)
  seoDescricao String? @db.VarChar(300)

  /// Array de blocos: [{ tipo: "hero", props: {...} }, ...]
  /// Validado por Zod discriminado em src/lib/validation/site.ts na escrita
  /// e re-validado na leitura antes de renderizar.
  blocos Json @default("[]")

  publicada   Boolean @default(false)
  ordemMenu   Int?
  mostrarMenu Boolean @default(true)
  sistema     Boolean @default(false) // páginas que não podem ser excluídas

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, slug])
  @@index([tenantId, publicada, ordemMenu])
  @@map("site_paginas")
}

/// Configuração do "Ao Vivo". O indicador pisca no site e no app quando
/// o canal está transmitindo.
model LiveConfig {
  id       String @id @default(cuid())
  tenantId String @unique

  /// ID do canal (UC...). Preferido: permite detectar live automaticamente.
  youtubeChannelId     String? @db.VarChar(40)
  /// Fallback: o cliente cola a URL/ID de uma transmissão específica.
  youtubeVideoIdManual String? @db.VarChar(20)

  /// Modo de operação:
  ///   AUTO   - consulta a API do YouTube e detecta sozinho
  ///   MANUAL - só fica ao vivo se `forcarAoVivo` estiver ligado
  ///   AGENDA - fica ao vivo apenas nas janelas de `janelas`
  modo String @default("AUTO") @db.VarChar(10)

  forcarAoVivo Boolean @default(false)

  /// Janelas de culto: [{ diaSemana: 0, inicio: "18:00", fim: "21:00" }].
  /// Fora delas nem consultamos a API — economiza cota e evita falso positivo
  /// com vídeo de ensaio.
  janelas Json @default("[]")

  fusoHorario String @default("America/Sao_Paulo") @db.VarChar(60)

  mensagemAoVivo String? @db.VarChar(120)
  exibirNoSite   Boolean @default(true)
  exibirNoApp    Boolean @default(true)

  // Cache do último resultado — evita estourar a cota da API do YouTube.
  ultimoCheckEm      DateTime?
  ultimoCheckAoVivo  Boolean   @default(false)
  ultimoVideoId      String?   @db.VarChar(20)
  ultimoTitulo       String?   @db.VarChar(200)
  /// Backoff quando a API falha ou a cota estoura.
  falhasConsecutivas Int       @default(0)

  atualizadoEm DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("live_configs")
}

/// Arquivo enviado por um tenant. O binário NUNCA fica em public/:
/// mora em STORAGE_DIR/<tenantId>/... e sai só pela rota autorizada.
model Arquivo {
  id       String @id @default(cuid())
  tenantId String

  nomeOriginal   String @db.VarChar(255)
  /// Nome no disco: aleatório, sem relação com o nome enviado. Impede
  /// path traversal e colisão.
  nomeArmazenado String @db.VarChar(80)
  /// Caminho relativo a STORAGE_DIR, sempre iniciando por "<tenantId>/".
  caminho        String @db.VarChar(400)

  /// MIME detectado pelos MAGIC BYTES do conteúdo — não pelo Content-Type
  /// enviado pelo cliente, que é trivialmente forjável.
  mimeType     String @db.VarChar(100)
  tamanhoBytes Int
  /// SHA-256 do conteúdo: deduplicação e verificação de integridade.
  sha256       String @db.VarChar(64)

  largura Int?
  altura  Int?

  /// true = pode ser servido sem sessão (logo, foto do site).
  /// false = exige sessão + membership no tenant.
  publico Boolean @default(false)

  enviadoPorId String?  @db.VarChar(30)
  criadoEm     DateTime @default(now())

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  mensagens Mensagem[]

  @@index([tenantId, criadoEm])
  @@index([tenantId, sha256])
  @@map("arquivos")
}

/// Auditoria por igreja. O ADMIN do tenant lê a sua; nunca a de outro.
model AuditLog {
  id       String @id @default(cuid())
  tenantId String

  atorUserId     String? @db.VarChar(30)
  atorNome       String? @db.VarChar(160)
  atorPapel      String? @db.VarChar(20)
  /// Preenchido quando a ação veio de uma sessão de impersonação.
  impersonadoPor String? @db.VarChar(254)

  acao     String  @db.VarChar(80) // "pessoa.criar", "oracao.ler", ...
  alvoTipo String? @db.VarChar(60)
  alvoId   String? @db.VarChar(60)

  /// Diferença antes/depois, já com campos sensíveis mascarados
  /// (ver src/lib/audit/redact.ts). Nunca gravar senha ou token aqui.
  detalhes Json?

  ipHash    String? @db.VarChar(64)
  userAgent String? @db.VarChar(255)

  criadoEm DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, criadoEm])
  @@index([tenantId, acao, criadoEm])
  @@index([tenantId, atorUserId, criadoEm])
  @@map("audit_logs")
}

/// Notificação para o app do membro.
model Notificacao {
  id       String @id @default(cuid())
  tenantId String

  titulo String  @db.VarChar(160)
  corpo  String  @db.Text
  link   String? @db.VarChar(300)

  /// Null = broadcast para todos os membros do tenant.
  destinatarioUserId String? @db.VarChar(30)

  lidaEm       DateTime?
  agendadaPara DateTime?
  enviadaEm    DateTime?

  criadoEm DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, destinatarioUserId, lidaEm])
  @@index([tenantId, criadoEm])
  @@map("notificacoes")
}

// =============================================================================
// FINANCEIRO — partidas dobradas, valores SEMPRE em centavos (BigInt)
//
// Regras inegociáveis (ver PROMPT do módulo):
//  - Dinheiro nunca é float: é BIGINT em centavos.
//  - Ledger append-only: lançamento não se edita nem apaga; correção = estorno
//    referenciado (estornoDeId).
//  - Partidas dobradas: por lançamento, Σ débitos = Σ créditos (invariante testada).
//  - Congregação = Campus (matriz = tenant). Consolidado = soma das congregações.
// =============================================================================

enum NaturezaConta {
  ATIVO
  PASSIVO
  PATRIMONIO
  RECEITA
  DESPESA
}

enum TipoContaFisica {
  DINHEIRO
  BANCO
  PIX
}

enum PapelFinanceiro {
  ADMIN_MATRIZ
  TESOUREIRO
  LANCADOR
  VISUALIZADOR
}

enum EscopoFinanceiro {
  MATRIZ
  CONGREGACAO
}

/// Plano de contas. Unifica contas físicas (Caixa/Banco/PIX — natureza ATIVO,
/// ligadas a uma congregação) e contas de resultado (Dízimo/Oferta = RECEITA;
/// Aluguel/Missões = DESPESA — em geral da matriz, campusId nulo).
model ContaContabil {
  id       String @id @default(cuid())
  tenantId String

  campusId String?

  codigo               String           @db.VarChar(20)
  nome                 String           @db.VarChar(120)
  natureza             NaturezaConta
  tipoFisico           TipoContaFisica?
  saldoInicialCentavos BigInt           @default(0)
  ativo                Boolean          @default(true)
  ordem                Int              @default(0)

  criadoEm DateTime @default(now())

  tenant   Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  campus   Campus?             @relation(fields: [campusId], references: [id], onDelete: SetNull)
  partidas PartidaFinanceira[]

  @@unique([tenantId, codigo])
  @@index([tenantId, natureza, ativo])
  @@index([tenantId, campusId])
  @@map("contas_contabeis")
}

/// Cabeçalho do lançamento (partida de diário). IMUTÁVEL após criado.
model LancamentoFinanceiro {
  id       String @id @default(cuid())
  tenantId String
  campusId String

  dataCompetencia DateTime @db.Date
  dataCaixa       DateTime @db.Date
  historico       String   @db.VarChar(300)
  valorCentavos   BigInt

  membroId            String?
  anexoId             String?
  contribuicaoAnonima Boolean @default(false)

  chaveIdempotencia String @db.VarChar(80)

  estornado   Boolean @default(false)
  estornoDeId String?

  criadoPorId String
  ip          String?  @db.VarChar(64)
  criadoEm    DateTime @default(now())

  tenant    Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  campus    Campus                 @relation(fields: [campusId], references: [id], onDelete: Cascade)
  partidas  PartidaFinanceira[]
  estornoDe LancamentoFinanceiro?  @relation("EstornoRef", fields: [estornoDeId], references: [id])
  estornos  LancamentoFinanceiro[] @relation("EstornoRef")

  @@unique([tenantId, chaveIdempotencia])
  @@index([tenantId, campusId, dataCompetencia])
  @@index([tenantId, campusId, dataCaixa])
  @@map("lancamentos_financeiros")
}

/// Linha de débito/crédito. Σ débitos = Σ créditos por lançamento.
model PartidaFinanceira {
  id       String @id @default(cuid())
  tenantId String

  lancamentoId String
  contaId      String

  debitoCentavos  BigInt @default(0)
  creditoCentavos BigInt @default(0)

  tenant     Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lancamento LancamentoFinanceiro @relation(fields: [lancamentoId], references: [id], onDelete: Cascade)
  conta      ContaContabil        @relation(fields: [contaId], references: [id])

  @@index([tenantId, contaId])
  @@index([tenantId, lancamentoId])
  @@map("partidas_financeiras")
}

/// Fechamento de período: trava a competência de uma congregação.
model FechamentoFinanceiro {
  id       String @id @default(cuid())
  tenantId String
  campusId String

  competencia        String  @db.VarChar(7)
  saldoFinalCentavos BigInt
  travado            Boolean @default(true)
  fechadoPorId       String

  fechadoEm DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  campus Campus @relation(fields: [campusId], references: [id], onDelete: Cascade)

  @@unique([tenantId, campusId, competencia])
  @@map("fechamentos_financeiros")
}

/// Acesso financeiro por pessoa e por congregação (papel financeiro), separado
/// do RBAC geral. Uma pessoa pode ser tesoureira da A e visualizadora da B.
model AcessoFinanceiro {
  id       String @id @default(cuid())
  tenantId String

  userId   String
  escopo   EscopoFinanceiro
  campusId String?
  papel    PapelFinanceiro

  criadoEm DateTime @default(now())

  tenant Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  campus Campus? @relation(fields: [campusId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId, campusId])
  @@index([tenantId, userId])
  @@map("acessos_financeiros")
}

// =============================================================================
// INSCRIÇÕES — a secretaria cria um "evento/curso" com link compartilhável;
// as pessoas se inscrevem em 1 toque (site/app) e a secretaria vê a lista.
// =============================================================================
model Inscricao {
  id       String @id @default(cuid())
  tenantId String

  titulo    String  @db.VarChar(160)
  descricao String? @db.VarChar(2000)
  /// Usado no link público /i/<slug>. Único por igreja.
  slug      String  @db.VarChar(80)

  ativa         Boolean   @default(true)
  encerraEm     DateTime?
  pedirTelefone Boolean   @default(true)
  pedirEmail    Boolean   @default(false)

  criadoPorId String
  criadoEm    DateTime @default(now())

  tenant    Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  respostas InscricaoResposta[]

  @@unique([tenantId, slug])
  @@index([tenantId, ativa, criadoEm])
  @@map("inscricoes")
}

model InscricaoResposta {
  id       String @id @default(cuid())
  tenantId String

  inscricaoId String

  nome       String  @db.VarChar(160)
  telefone   String? @db.VarChar(20)
  email      String? @db.VarChar(254)
  observacao String? @db.VarChar(500)
  ip         String? @db.VarChar(64)

  criadoEm DateTime @default(now())

  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  inscricao Inscricao @relation(fields: [inscricaoId], references: [id], onDelete: Cascade)

  @@index([tenantId, inscricaoId, criadoEm])
  @@map("inscricao_respostas")
}

// =============================================================================
// KIDS — Ministério Infantil. DADOS DE MENORES: o núcleo mais sensível.
// Regras: entrega só com código de segurança; QR opaco/assinado/efêmero;
// vínculo verificado criança↔responsável; auditoria total; consentimento LGPD.
// =============================================================================

enum StatusSessaoKids {
  EM_SALA
  RETIRADA
}

enum TipoEvolucao {
  PRESENCA
  LICAO
  MARCO
  CONQUISTA
}

model Crianca {
  id       String @id @default(cuid())
  tenantId String

  nome           String   @db.VarChar(160)
  apelido        String?  @db.VarChar(60)
  dataNascimento DateTime @db.Date
  fotoId         String? // Arquivo (só com consentimento de foto)

  alergias              String? @db.VarChar(500)
  restricoes            String? @db.VarChar(500)
  necessidadesEspeciais String? @db.VarChar(500)
  observacoes           String? @db.VarChar(1000)

  salaPadraoId String?

  /// Consentimentos LGPD (art. 14). Sem o consentimento de dados, a criança
  /// não opera no sistema. Consentimento de foto é separado e revogável.
  consentimentoLgpd Boolean @default(false)
  consentimentoFoto Boolean @default(false)

  criadoEm     DateTime  @default(now())
  atualizadoEm DateTime  @updatedAt
  excluidoEm   DateTime?

  tenant       Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  salaPadrao   SalaKids?            @relation(fields: [salaPadraoId], references: [id], onDelete: SetNull)
  responsaveis CriancaResponsavel[]
  sessoes      SessaoSalaKids[]
  evolucoes    EvolucaoKids[]
  conquistas   ConquistaKids[]

  @@index([tenantId, excluidoEm, nome])
  @@map("criancas")
}

model CriancaResponsavel {
  id       String @id @default(cuid())
  tenantId String

  criancaId         String
  /// Conta do responsável (User global). O acompanhamento ao vivo só é liberado
  /// para contas comprovadamente vinculadas — é aqui que o anti-IDOR começa.
  responsavelUserId String
  nome              String  @db.VarChar(160)
  parentesco        String? @db.VarChar(40)
  whatsapp          String? @db.VarChar(20)

  autorizadoRetirar Boolean @default(true)
  principal         Boolean @default(false)

  criadoEm DateTime @default(now())

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  crianca Crianca @relation(fields: [criancaId], references: [id], onDelete: Cascade)

  @@unique([criancaId, responsavelUserId])
  @@index([tenantId, responsavelUserId])
  @@map("crianca_responsaveis")
}

model SalaKids {
  id       String @id @default(cuid())
  tenantId String

  nome        String  @db.VarChar(80)
  faixaEtaria String? @db.VarChar(40)
  capacidade  Int?
  ativa       Boolean @default(true)
  ordem       Int     @default(0)

  criadoEm DateTime @default(now())

  tenant   Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  criancas Crianca[]
  sessoes  SessaoSalaKids[]

  @@index([tenantId, ativa, ordem])
  @@map("salas_kids")
}

model SessaoSalaKids {
  id       String @id @default(cuid())
  tenantId String

  criancaId String
  salaId    String

  cultoData           DateTime         @db.Date
  status              StatusSessaoKids @default(EM_SALA)
  /// HASH do código de segurança (nunca o código em claro).
  codigoSegurancaHash String           @db.VarChar(64)

  checkinEm         DateTime  @default(now())
  checkinPor        String
  checkoutEm        DateTime?
  checkoutPor       String?
  /// Qual responsável autorizado retirou (auditoria da entrega).
  retiradoPorUserId String?

  tenant  Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  crianca Crianca       @relation(fields: [criancaId], references: [id], onDelete: Cascade)
  sala    SalaKids      @relation(fields: [salaId], references: [id], onDelete: Cascade)
  tokens  QrTokenKids[]

  @@index([tenantId, status, cultoData])
  @@index([tenantId, criancaId, cultoData])
  @@map("sessoes_sala_kids")
}

model QrTokenKids {
  id       String @id @default(cuid())
  tenantId String

  sessaoId String
  expiraEm DateTime
  usado    Boolean  @default(false)

  criadoEm DateTime @default(now())

  tenant Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sessao SessaoSalaKids @relation(fields: [sessaoId], references: [id], onDelete: Cascade)

  @@index([tenantId, sessaoId])
  @@map("qr_tokens_kids")
}

model EvolucaoKids {
  id       String @id @default(cuid())
  tenantId String

  criancaId String
  tipo      TipoEvolucao
  titulo    String       @db.VarChar(160)
  descricao String?      @db.VarChar(1000)
  data      DateTime     @db.Date
  midiaId   String?

  criadoEm DateTime @default(now())

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  crianca Crianca @relation(fields: [criancaId], references: [id], onDelete: Cascade)

  @@index([tenantId, criancaId, data])
  @@map("evolucoes_kids")
}

model ConquistaKids {
  id       String @id @default(cuid())
  tenantId String

  criancaId     String
  nome          String   @db.VarChar(80)
  icone         String   @db.VarChar(40)
  conquistadaEm DateTime @default(now())

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  crianca Crianca @relation(fields: [criancaId], references: [id], onDelete: Cascade)

  @@index([tenantId, criancaId])
  @@map("conquistas_kids")
}

// =============================================================================
// TEMPLATES DE MENSAGEM — automações editáveis pela secretaria.
// O corpo aceita variáveis {nome}, {igreja}, {data}, {assinatura}, etc., que o
// renderizador (src/lib/mensagens/template.ts) substitui na hora do envio.
// =============================================================================
model MensagemTemplate {
  id       String @id @default(cuid())
  tenantId String

  /// Identificador da automação: 'boas_vindas_visitante', 'aniversario_vida',
  /// 'aniversario_batismo', 'convite_retorno', etc.
  chave  String  @db.VarChar(60)
  titulo String  @db.VarChar(120)
  corpo  String  @db.Text
  ativo  Boolean @default(true)

  atualizadoEm DateTime @updatedAt
  criadoEm     DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, chave])
  @@map("mensagens_templates")
}

// =============================================================================
// MINISTÉRIO DE LOUVOR — equipe, escala do mês, repertório/cifras e chat.
// Genérico o bastante para outros ministérios (multimídia, recepção…), mas o
// foco é louvor. Tudo tenant-scoped + RLS. As automações de WhatsApp
// (convocação/confirmação) reaproveitam o módulo whatsapp; o webhook de
// resposta atualiza EscaladoEvento.status.
// =============================================================================

enum TipoMinisterio {
  LOUVOR
  MULTIMIDIA
  RECEPCAO
  INTERCESSAO
  DANCA
  OUTRO
}

enum StatusEscala {
  RASCUNHO
  PUBLICADA
}

enum TipoEventoEscala {
  CULTO
  ENSAIO
  EVENTO
}

enum PapelEscalado {
  MINISTRANTE
  INSTRUMENTISTA
  VOCAL
  MULTIMIDIA
}

enum StatusEscalado {
  PENDENTE
  CONFIRMADO
  RECUSADO
  TROCA_SOLICITADA
}

model Ministerio {
  id       String @id @default(cuid())
  tenantId String

  nome  String         @db.VarChar(80)
  tipo  TipoMinisterio @default(LOUVOR)
  ativo Boolean        @default(true)

  criadoEm DateTime @default(now())

  tenant    Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  membros   MembroMinisterio[]
  funcoes   FuncaoMinisterio[]
  escalas   EscalaMinisterio[]
  musicas   MusicaMinisterio[]
  mensagens ChatMinisterio[]

  @@index([tenantId, ativo])
  @@map("ministerios")
}

model MembroMinisterio {
  id           String @id @default(cuid())
  tenantId     String
  ministerioId String

  /// Vínculo com a conta (para o roteador de acesso e o app do membro). Pode
  /// ficar nulo enquanto o convite não é aceito.
  userId   String?
  /// Vínculo com a pessoa cadastrada na igreja (fonte do WhatsApp, foto…).
  pessoaId String?

  nome     String  @db.VarChar(160)
  whatsapp String? @db.VarChar(20)
  fotoId   String?
  ehLider  Boolean @default(false)
  ativo    Boolean @default(true)

  criadoEm DateTime @default(now())

  tenant             Tenant                        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ministerio         Ministerio                    @relation(fields: [ministerioId], references: [id], onDelete: Cascade)
  funcoes            MembroFuncao[]
  escalados          EscaladoEvento[]
  indisponibilidades IndisponibilidadeMinisterio[]

  @@index([tenantId, ministerioId, ativo])
  @@index([tenantId, userId])
  @@map("membros_ministerio")
}

model FuncaoMinisterio {
  id           String @id @default(cuid())
  tenantId     String
  ministerioId String

  nome  String @db.VarChar(60)
  ordem Int    @default(0)

  tenant     Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ministerio Ministerio       @relation(fields: [ministerioId], references: [id], onDelete: Cascade)
  membros    MembroFuncao[]
  escalados  EscaladoEvento[]

  @@index([tenantId, ministerioId, ordem])
  @@map("funcoes_ministerio")
}

model MembroFuncao {
  id       String @id @default(cuid())
  tenantId String

  membroId String
  funcaoId String

  tenant Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  membro MembroMinisterio @relation(fields: [membroId], references: [id], onDelete: Cascade)
  funcao FuncaoMinisterio @relation(fields: [funcaoId], references: [id], onDelete: Cascade)

  @@unique([membroId, funcaoId])
  @@index([tenantId])
  @@map("membro_funcoes")
}

model IndisponibilidadeMinisterio {
  id       String @id @default(cuid())
  tenantId String

  membroId String
  inicio   DateTime @db.Date
  fim      DateTime @db.Date
  motivo   String?  @db.VarChar(200)

  criadoEm DateTime @default(now())

  tenant Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  membro MembroMinisterio @relation(fields: [membroId], references: [id], onDelete: Cascade)

  @@index([tenantId, membroId])
  @@map("indisponibilidades_ministerio")
}

model EscalaMinisterio {
  id           String @id @default(cuid())
  tenantId     String
  ministerioId String

  mes    Int
  ano    Int
  status StatusEscala @default(RASCUNHO)

  publicadaEm DateTime?
  criadoEm    DateTime  @default(now())

  tenant     Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ministerio Ministerio     @relation(fields: [ministerioId], references: [id], onDelete: Cascade)
  eventos    EventoEscala[]

  @@unique([ministerioId, ano, mes])
  @@index([tenantId, ministerioId])
  @@map("escalas_ministerio")
}

model EventoEscala {
  id       String @id @default(cuid())
  tenantId String
  escalaId String

  data              DateTime         @db.Date
  hora              String           @db.VarChar(5)
  tipo              TipoEventoEscala @default(CULTO)
  titulo            String           @db.VarChar(120)
  dressCodeTexto    String?          @db.VarChar(200)
  dressCodeImagemId String?
  observacoes       String?          @db.VarChar(1000)

  criadoEm DateTime @default(now())

  tenant    Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  escala    EscalaMinisterio @relation(fields: [escalaId], references: [id], onDelete: Cascade)
  escalados EscaladoEvento[]
  musicas   EventoMusica[]

  @@index([tenantId, escalaId, data])
  @@map("eventos_escala")
}

model EscaladoEvento {
  id       String @id @default(cuid())
  tenantId String

  eventoId String
  membroId String
  funcaoId String?

  papel  PapelEscalado  @default(INSTRUMENTISTA)
  status StatusEscalado @default(PENDENTE)

  respondidoEm DateTime?
  criadoEm     DateTime  @default(now())

  tenant Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  evento EventoEscala      @relation(fields: [eventoId], references: [id], onDelete: Cascade)
  membro MembroMinisterio  @relation(fields: [membroId], references: [id], onDelete: Cascade)
  funcao FuncaoMinisterio? @relation(fields: [funcaoId], references: [id], onDelete: SetNull)

  @@index([tenantId, eventoId])
  @@index([tenantId, membroId])
  @@map("escalados_evento")
}

model MusicaMinisterio {
  id           String @id @default(cuid())
  tenantId     String
  ministerioId String

  titulo    String  @db.VarChar(160)
  artista   String? @db.VarChar(120)
  tomPadrao String? @db.VarChar(8)
  linkCifra String? @db.VarChar(500)
  linkLetra String? @db.VarChar(500)
  linkVideo String? @db.VarChar(500)
  linkAudio String? @db.VarChar(500)
  /// Cifra colada direto (opcional) — permite transpor no app sem sair pra fora.
  cifra     String? @db.Text
  tags      String? @db.VarChar(200)

  criadoEm DateTime @default(now())

  tenant     Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ministerio Ministerio     @relation(fields: [ministerioId], references: [id], onDelete: Cascade)
  eventos    EventoMusica[]

  @@index([tenantId, ministerioId, titulo])
  @@map("musicas_ministerio")
}

model EventoMusica {
  id       String @id @default(cuid())
  tenantId String

  eventoId String
  musicaId String
  tomDoDia String? @db.VarChar(8)
  ordem    Int     @default(0)

  tenant Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  evento EventoEscala     @relation(fields: [eventoId], references: [id], onDelete: Cascade)
  musica MusicaMinisterio @relation(fields: [musicaId], references: [id], onDelete: Cascade)

  @@index([tenantId, eventoId, ordem])
  @@map("evento_musicas")
}

model ChatMinisterio {
  id           String @id @default(cuid())
  tenantId     String
  ministerioId String

  /// Tópico opcional por evento; nulo = canal geral do ministério.
  eventoId    String?
  autorUserId String
  autorNome   String  @db.VarChar(160)
  texto       String  @db.VarChar(2000)
  fixada      Boolean @default(false)

  criadoEm DateTime @default(now())

  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ministerio Ministerio @relation(fields: [ministerioId], references: [id], onDelete: Cascade)

  @@index([tenantId, ministerioId, criadoEm])
  @@map("chat_ministerio")
}

// =============================================================================
// CONFIGURAÇÃO DO APP DE MEMBROS — toggles que o admin liga/desliga por igreja.
// Recurso desligado some da navegação do app (a lógica está em
// src/lib/app-membro/recursos.ts). Uma linha por tenant.
// =============================================================================
model ConfiguracaoAppMembro {
  id       String @id @default(cuid())
  tenantId String @unique

  inicio       Boolean @default(true)
  palavra      Boolean @default(true)
  contribuir   Boolean @default(true)
  agenda       Boolean @default(true)
  celula       Boolean @default(false)
  perfil       Boolean @default(true)
  notificacoes Boolean @default(true)

  atualizadoEm DateTime @updatedAt
  criadoEm     DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("config_app_membro")
}

// =============================================================================
// CONTRIBUIÇÃO (Contribuir do app) — cobrança PIX via ASAAS que, ao ser
// confirmada pelo webhook, vira UM lançamento de entrada no Financeiro
// (partidas dobradas, centavos). Tenant-scoped + RLS.
// =============================================================================
enum TipoContribuicao {
  DIZIMO
  OFERTA
  MISSOES
}

enum StatusContribuicao {
  PENDENTE
  CONFIRMADA
  CANCELADA
  EXPIRADA
}

model Contribuicao {
  id       String @id @default(cuid())
  tenantId String

  /// Membro que contribuiu (opcional: pode ser anônima/visitante).
  membroUserId String?
  campusId     String?
  nome         String? @db.VarChar(160)

  tipo          TipoContribuicao
  valorCentavos BigInt
  status        StatusContribuicao @default(PENDENTE)

  /// Referências do gateway. asaasPaymentId é único por igreja (idempotência
  /// do webhook: o mesmo pagamento nunca gera dois lançamentos).
  asaasPaymentId String? @db.VarChar(60)
  pixCopiaECola  String? @db.Text

  /// Lançamento gerado no Financeiro quando a contribuição é confirmada.
  lancamentoId String?

  criadoEm     DateTime  @default(now())
  confirmadaEm DateTime?

  tenant Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  campus Campus? @relation(fields: [campusId], references: [id], onDelete: SetNull)

  @@unique([tenantId, asaasPaymentId])
  @@index([tenantId, status, criadoEm])
  @@index([tenantId, membroUserId])
  @@map("contribuicoes")
}

// =============================================================================
// CONFIGURAÇÃO DE PAGAMENTO — credenciais do gateway (ASAAS) por igreja,
// editáveis no painel. A chave da API é guardada CIFRADA (criptografar/
// descriptografar em src/lib/crypto.ts) e NUNCA volta para o cliente.
// Quando preenchida e ativa, tem prioridade sobre as variáveis de ambiente.
// =============================================================================
model ConfiguracaoPagamento {
  tenantId String @id

  provedor            String  @default("ASAAS")
  ambiente            String  @default("producao") // producao | sandbox
  apiKeyCriptografada String? @db.Text
  webhookToken        String? @db.VarChar(120)
  ativo               Boolean @default(false)

  atualizadoEm DateTime @updatedAt
  criadoEm     DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("config_pagamento")
}

// =============================================================================
// MÓDULOS ("gavetas") habilitados por igreja. O Super Admin liga/desliga cada
// área; ao ligar, a área aparece e se conecta ao resto. `gestao` é a base.
// Lógica pura em src/lib/modulos/modulos.ts. Uma linha por tenant.
// =============================================================================
model ConfiguracaoModulos {
  tenantId String @id

  gestao      Boolean @default(true)
  site        Boolean @default(true)
  app         Boolean @default(true)
  louvor      Boolean @default(true)
  kids        Boolean @default(true)
  financeiro  Boolean @default(true)
  inscricoes  Boolean @default(true)
  celulas     Boolean @default(true)
  escola      Boolean @default(true)
  comunicacao Boolean @default(true)

  atualizadoEm DateTime @updatedAt
  criadoEm     DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("config_modulos")
}
