# =============================================================================
# postgresql.conf — exemplo para a VPS do Discipular
# Alvo: 4 vCPU / 8 GB RAM / disco SSD (NVMe), Ubuntu, PostgreSQL 15+
# Perfil: OLTP leve — 30 igrejas, ~90 usuários simultâneos, muitas consultas
#         pequenas e indexadas, quase nenhum relatório analítico.
#
# COMO USAR
# Não substitua o postgresql.conf da distribuição. Copie o conteúdo abaixo para
#   /etc/postgresql/15/main/conf.d/discipular.conf
# (o Debian/Ubuntu já faz `include_dir = 'conf.d'`). Assim o arquivo da
# distribuição continua atualizável pelo apt e o que é nosso fica isolado e
# versionado.
#
#   sudo systemctl reload postgresql   # para a maioria dos parâmetros
#   sudo systemctl restart postgresql  # para os marcados [RESTART] abaixo
#
# Confira o que ficou valendo e de onde veio:
#   SELECT name, setting, unit, source, sourcefile
#     FROM pg_settings WHERE source NOT IN ('default','override') ORDER BY name;
#
# A PREMISSA QUE MUDA TUDO: o Node roda NA MESMA MÁQUINA.
# As receitas de tuning que circulam por aí assumem um servidor dedicado a
# banco. Aqui o processo Next.js consome ~0,5–1 GB e o Nginx um pouco, então os
# números de memória abaixo são deliberadamente mais conservadores que os
# "25% / 75%" de manual. Se um dia o banco sair para uma máquina própria,
# releia as seções 1 e 2.
# =============================================================================


# =============================================================================
# 1. MEMÓRIA
# =============================================================================

# Cache de páginas do próprio Postgres. 2 GB = 25% da RAM, o ponto de partida
# clássico. Toda a base do sistema (60 mil pessoas + índices) cabe folgadamente
# aqui, o que é justamente o objetivo: depois do aquecimento, praticamente
# nenhuma leitura toca o disco.
# Se o processo Node crescer e o servidor começar a usar swap, este é o primeiro
# número a baixar (para 1536MB). Swap em servidor de banco é pior que qualquer
# desperdício de cache.
shared_buffers = 2GB                    # [RESTART]

# Estimativa de quanta memória existe no total para cache — a do Postgres MAIS
# a do sistema operacional. Não aloca nada: é uma dica para o planner decidir
# entre Index Scan e Seq Scan. Subestimar faz o planner escolher varredura
# sequencial onde o índice era melhor.
# 4 GB e não 6 GB porque Node + Nginx + OS ficam com o resto.
effective_cache_size = 4GB

# Memória por operação de ordenação/hash — POR NÓ do plano, não por conexão.
# Uma query com 3 sorts pode usar 3 × work_mem.
# Conta do pior caso: 60 conexões × ~2 nós × 8MB ≈ 960 MB. Somado aos 2 GB de
# shared_buffers, sobra folga para o Node. Números maiores (32MB, 64MB) são o
# erro clássico: parecem inofensivos até 60 sessões pedirem tudo ao mesmo tempo.
#
# Para o relatório mensal pesado, NÃO mude o global — eleve só naquela sessão:
#   BEGIN; SET LOCAL work_mem = '128MB'; SELECT ...; COMMIT;
work_mem = 8MB

# VACUUM, CREATE INDEX, ALTER TABLE. Pode ser generoso porque poucas rodam ao
# mesmo tempo — mas veja autovacuum_work_mem logo abaixo.
maintenance_work_mem = 512MB

# ARMADILHA: sem este parâmetro, cada worker do autovacuum herda
# maintenance_work_mem. Com 3 workers seriam 1,5 GB de pico, em silêncio, na
# madrugada, exatamente quando ninguém está olhando. Limitamos a 256 MB × 3.
autovacuum_work_mem = 256MB

# Reduz a pressão sobre a TLB do processador para os 2 GB de shared_buffers.
# `try` é seguro: se as huge pages não estiverem disponíveis, o Postgres sobe
# normalmente com páginas comuns em vez de recusar iniciar.
huge_pages = try                        # [RESTART]


# =============================================================================
# 2. CONEXÕES — coerente com o connection_limit do Prisma
# =============================================================================
# A conta que precisa fechar (e que é a causa nº 1 de "sorry, too many clients"):
#
#   DATABASE_URL tem `connection_limit=10`  -> 10 conexões POR PROCESSO Node
#   PM2 com 2 instâncias                    -> 20
#   migrações (DIRECT_DATABASE_URL)         ->  2
#   pg_dump noturno                         ->  2
#   psql do operador / monitoramento        ->  4
#                                              ---
#                                               28  em uso normal
#
# 60 dá o dobro de folga para um deploy que se sobreponha ao processo antigo
# (comum: o novo sobe antes de o velho morrer, dobrando o pool por alguns
# segundos). Não aumente `connection_limit` do Prisma sem refazer esta conta:
# conexão no Postgres é um PROCESSO do sistema operacional, não uma thread —
# 200 conexões ociosas custam RAM real e trocas de contexto reais.
#
# Regra prática: mais throughput NÃO vem de mais conexões. Com 4 vCPU, o ponto
# ótimo de paralelismo fica entre 8 e 16 queries realmente ativas. O resto é fila.
max_connections = 60                    # [RESTART]

# Reserva para o DBA entrar quando o app tiver esgotado o pool. Sem isto, o
# incidente em que você mais precisa do `psql` é justamente o que impede de abri-lo.
superuser_reserved_connections = 5      # [RESTART]

# O banco atende Node e Nginx no mesmo host. Não há motivo para expor 5432 na
# internet. Confira também o pg_hba.conf: `host all all 0.0.0.0/0 md5` é como se
# perde um banco inteiro. Use `local`/`127.0.0.1` com `scram-sha-256`.
listen_addresses = 'localhost'          # [RESTART]
password_encryption = 'scram-sha-256'

# Derruba conexões mortas por queda de rede/NAT em vez de deixá-las ocupando
# slot até o timeout do kernel (~2 horas por padrão no Linux).
tcp_keepalives_idle = 60
tcp_keepalives_interval = 10
tcp_keepalives_count = 3


# =============================================================================
# 3. TIMEOUTS — a proteção contra o incidente que vira indisponibilidade
# =============================================================================
# Com RLS ativa (ver prisma/RLS.md), TODA requisição vira uma transação
# interativa que prende uma conexão do pool. Uma transação esquecida aberta
# deixa de ser lentidão e vira: pool esgotado, autovacuum bloqueado, tabelas
# inchando. Estes timeouts são o cinto de segurança.

# 30s é generoso para qualquer requisição web legítima e curto o bastante para
# que um bug não derrube o sistema. Vale para TODAS as sessões.
idle_in_transaction_session_timeout = 30s

# Globalmente 0 (sem limite), porque migração e backup precisam de tempo.
# O limite vai por PAPEL, onde ele realmente importa — rode uma vez:
#
#   ALTER ROLE discipular_app SET statement_timeout = '15s';
#   ALTER ROLE discipular_app SET lock_timeout = '3s';
#   ALTER ROLE discipular_app SET idle_in_transaction_session_timeout = '15s';
#
# Assim o processo web nunca segura nada por muito tempo, e o migrator continua
# livre para um CREATE INDEX demorado.
statement_timeout = 0
lock_timeout = 0

# Registrar espera por lock ajuda a diagnosticar contenção. 1s é o padrão.
deadlock_timeout = 1s


# =============================================================================
# 4. DISCO E PLANEJADOR (SSD/NVMe)
# =============================================================================

# O padrão 4.0 vem da era do disco mecânico, onde busca aleatória custava ~4×
# uma leitura sequencial. Em SSD a diferença é quase nula. Manter 4.0 faz o
# planner subestimar índices e preferir Seq Scan — exatamente o oposto do que
# queremos num sistema onde todo índice começa por "tenantId".
random_page_cost = 1.1
seq_page_cost = 1.0

# Quantas leituras assíncronas simultâneas o disco aguenta. NVMe aguenta muito;
# 200 é o valor usual para SSD.
effective_io_concurrency = 200
maintenance_io_concurrency = 200

# --- Paralelismo
# 4 vCPU compartilhadas com o Node. Consultas paralelas ajudam relatórios e
# atrapalham OLTP (cada worker é um processo a mais disputando CPU). Deixamos
# 2 workers por consulta — suficiente para o relatório mensal, insuficiente
# para uma query boba monopolizar a máquina.
max_worker_processes = 4                # [RESTART]
max_parallel_workers = 4
max_parallel_workers_per_gather = 2
max_parallel_maintenance_workers = 2

# JIT compila expressões em consultas caras. Aqui as consultas são pequenas e
# indexadas: o tempo de compilação (dezenas de ms) supera o ganho e aparece como
# picos de latência inexplicáveis. Desligar é o certo para este perfil.
jit = off

# 100 é o padrão e serve. Se a busca por nome em `pessoas` começar a escolher
# planos ruins, suba só naquela coluna, não globalmente:
#   ALTER TABLE pessoas ALTER COLUMN nome SET STATISTICS 500; ANALYZE pessoas;
default_statistics_target = 100


# =============================================================================
# 5. WAL, CHECKPOINT E DURABILIDADE
# =============================================================================

wal_level = replica                     # [RESTART]  permite pg_basebackup/réplica

# Checkpoints muito frequentes (o padrão 1GB dispara demais sob carga de
# escrita) produzem picos de I/O. 2GB espaça os checkpoints; com
# completion_target 0.9 a escrita é espalhada por 90% do intervalo, virando um
# fluxo constante em vez de rajadas que travam as requisições.
max_wal_size = 2GB
min_wal_size = 512MB
checkpoint_timeout = 15min
checkpoint_completion_target = 0.9

# Menos bytes de WAL no disco e no backup, em troca de um pouco de CPU. Em SSD
# de VPS, o I/O é o recurso mais escasso — a troca compensa.
wal_compression = on

# NÃO desligue. `synchronous_commit = off` deixa o commit mais rápido ao custo
# de perder os últimos ~200 ms de transações se a VPS cair. Aqui isso significa
# perder o cadastro que a secretária acabou de salvar, ou um pedido de oração —
# e a pessoa acredita que enviou. A dívida não é técnica, é pastoral.
synchronous_commit = on

# Buffer de WAL. 16MB é confortável para este volume.
wal_buffers = 16MB                      # [RESTART]


# =============================================================================
# 6. AUTOVACUUM
# =============================================================================
# Nunca desligue. Todo caso de "o Postgres ficou lento do nada" que não é falta
# de índice é autovacuum atrasado.

autovacuum = on
autovacuum_max_workers = 3              # [RESTART]

# 60s (padrão) é lento demais para tabelas de fila como `submissoes`, onde as
# linhas mudam de status o tempo todo.
autovacuum_naptime = 30s

# O padrão (200) foi calibrado para disco mecânico e faz o vacuum se
# autolimitar de forma absurda em SSD. Elevar acelera muito a limpeza sem
# impacto perceptível.
autovacuum_vacuum_cost_limit = 1000
autovacuum_vacuum_cost_delay = 2ms

# 20% de linhas mortas antes de limpar é muito para tabelas ativas.
autovacuum_vacuum_scale_factor = 0.1
autovacuum_analyze_scale_factor = 0.05

# Ajustes por tabela para as append-only (`audit_logs`, `interacoes`,
# `arquivos`) já estão na migração 20260101000001_indices — ficam versionados
# junto com o schema, e não escondidos num arquivo de configuração do servidor.


# =============================================================================
# 7. LOGS
# =============================================================================
#
# ############################################################################
# # NÃO USE log_statement = 'all' NESTE SISTEMA.                             #
# ############################################################################
#
# `log_statement = 'all'` grava o texto de TODA instrução executada. Neste
# banco, o texto das instruções contém:
#   - nome, e-mail, telefone, endereço e data de nascimento de membros
#   - o CONTEÚDO dos pedidos de oração: doença, morte na família, crise
#     conjugal, depressão, dívida
#   - observações pastorais, respostas do formulário de batismo
#
# Ou seja: dado pessoal e dado pessoal SENSÍVEL (art. 5º, II da LGPD — convicção
# religiosa e saúde), copiado em texto puro para um arquivo que
#   - não é criptografado,
#   - é lido por qualquer processo com acesso ao disco,
#   - vai inteiro para o backup e para qualquer agregador de logs,
#   - fica fora de qualquer rotina de exclusão a pedido do titular.
#
# Uma pessoa que pede exclusão dos dados continuaria tendo o pedido de oração
# dela em `/var/log/postgresql/`, meses depois, sem que ninguém saiba.
#
# Fora isso, o log de todas as instruções custa I/O em cima do recurso mais
# escasso da VPS e enche o disco — e disco cheio derruba o Postgres.
#
# Se você precisa depurar UMA sessão, ligue só nela e desligue depois:
#   SET log_statement = 'all';   -- na própria sessão, nunca no arquivo
#
log_statement = 'ddl'
# Por que 'ddl' e não 'none': instruções DDL não contêm dado pessoal (são
# CREATE/ALTER/DROP) e são raríssimas neste sistema — o papel de runtime nem
# tem permissão para executá-las. Logá-las custa quase nada e registra
# exatamente o que mais interessa a um investigador:
#     ALTER TABLE pessoas DISABLE ROW LEVEL SECURITY;
# Se essa linha aparecer no log, algo muito errado aconteceu — e você vai saber.

log_destination = 'stderr'
logging_collector = on                  # [RESTART]
log_directory = 'log'
log_filename = 'postgresql-%Y-%m-%d.log'
log_rotation_age = 1d
log_rotation_size = 100MB
log_truncate_on_rotation = on           # mantém ~7 dias sem encher o disco

# Prefixo com hora, PID, usuário, banco, host e ID de transação. Sem isso, um
# log de erro é uma frase solta sem dono.
log_line_prefix = '%m [%p] %q%u@%d %h %x '

# --- Consultas lentas
# 500 ms é o limiar em que o usuário percebe demora. Registra o suficiente para
# achar o índice que falta, sem virar log de tudo.
log_min_duration_statement = 500ms

# ############################################################################
# # ARMADILHA DE PRIVACIDADE — leia antes de mexer.                          #
# ############################################################################
# O padrão de log_parameter_max_length é -1, que significa "registre os
# parâmetros INTEIROS". Como o Prisma usa protocolo estendido (a query vai com
# $1, $2 e os valores separados), uma consulta lenta seria registrada assim:
#
#   LOG: duration: 812ms  execute s1: SELECT ... FROM "pedidos_oracao" WHERE ...
#   DETAIL: parameters: $1 = 'clx...', $2 = 'Minha esposa recebeu o diagnóstico'
#
# Ou seja: ligar log_min_duration_statement com o padrão reintroduz, pela porta
# dos fundos, exatamente o vazamento que o log_statement='all' causaria — só
# que aos poucos, e sem ninguém notar.
# 0 = registra a query mas NENHUM valor de parâmetro. Para investigar, o plano
# e o texto normalizado bastam.
log_parameter_max_length = 0
log_parameter_max_length_on_error = 0

# --- Diagnóstico operacional (não contém dado pessoal)
log_checkpoints = on
log_connections = on
log_disconnections = on
log_lock_waits = on                     # contenção, essencial com transações de RLS
log_autovacuum_min_duration = 250ms
log_temp_files = 0                      # qualquer arquivo temporário = work_mem curto
log_min_messages = warning
log_min_error_statement = error
log_error_verbosity = default
log_timezone = 'UTC'

# Tempos de I/O em EXPLAIN (ANALYZE, BUFFERS). Custo desprezível em kernel
# moderno e é a diferença entre adivinhar e medir.
track_io_timing = on
track_functions = pl


# =============================================================================
# 8. pg_stat_statements — onde o tempo realmente é gasto
# =============================================================================
# Depois de instalar: CREATE EXTENSION IF NOT EXISTS pg_stat_statements;
#
# Sobre privacidade: esta extensão guarda a query NORMALIZADA — as constantes
# viram $1, $2. Ela não acumula os valores, então não há dado pessoal em
# pg_stat_statements. A exceção são as instruções utilitárias (SET, VACUUM,
# ALTER), guardadas na íntegra — inclusive o `set_config('app.tenant_id', ...)`
# de cada requisição, que além de não ser útil poluiria a tabela. Daí
# track_utility = off.
shared_preload_libraries = 'pg_stat_statements'   # [RESTART]
pg_stat_statements.max = 5000
pg_stat_statements.track = top
pg_stat_statements.track_utility = off
pg_stat_statements.save = on

# As 20 consultas que mais consomem tempo total (não as mais lentas — as que
# mais somam, que é o que realmente derruba um servidor):
#   SELECT calls, round(total_exec_time::numeric,1) AS ms_total,
#          round(mean_exec_time::numeric,2) AS ms_medio, query
#     FROM pg_stat_statements ORDER BY total_exec_time DESC LIMIT 20;


# =============================================================================
# 9. LOCALIZAÇÃO
# =============================================================================
# O banco guarda e devolve UTC; a formatação para America/Sao_Paulo acontece na
# aplicação. Deixar o banco em fuso local é o caminho mais curto para bugs de
# horário de verão e para um agendamento de culto no dia errado.
timezone = 'UTC'
datestyle = 'iso, dmy'
lc_messages = 'C'                       # mensagens de erro em inglês: procuráveis
lc_monetary = 'pt_BR.UTF-8'
lc_numeric = 'pt_BR.UTF-8'
lc_time = 'pt_BR.UTF-8'
default_text_search_config = 'pg_catalog.portuguese'


# =============================================================================
# 10. DEPOIS DE APLICAR — verificação rápida
# =============================================================================
#   sudo systemctl restart postgresql
#   sudo -u postgres psql -c "SELECT name, setting, unit FROM pg_settings
#     WHERE name IN ('shared_buffers','effective_cache_size','work_mem',
#                    'maintenance_work_mem','max_connections','random_page_cost',
#                    'log_min_duration_statement','log_statement',
#                    'log_parameter_max_length','jit');"
#
# Acompanhe por uma semana:
#   - taxa de acerto de cache (deve passar de 0.99 depois do aquecimento):
#       SELECT sum(blks_hit)::float/nullif(sum(blks_hit+blks_read),0)
#         FROM pg_stat_database;
#   - conexões em uso vs. max_connections:
#       SELECT state, count(*) FROM pg_stat_activity GROUP BY state;
#   - arquivos temporários (se aparecerem, work_mem está curto):
#       SELECT datname, temp_files, pg_size_pretty(temp_bytes)
#         FROM pg_stat_database WHERE temp_files > 0;
#   - transações penduradas (o risco nº 1 com RLS):
#       SELECT pid, state, now()-xact_start AS duracao, query
#         FROM pg_stat_activity
#        WHERE state = 'idle in transaction' ORDER BY 3 DESC;
# =============================================================================
