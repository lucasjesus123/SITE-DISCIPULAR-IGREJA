# =============================================================================
# Discipular SaaS — modelo de variáveis de ambiente
#
# COPIE para `.env` e preencha. O arquivo `.env` está no .gitignore e NUNCA
# deve ser commitado. Este arquivo (.env.example) só contém PLACEHOLDERS —
# nenhum valor real de produção pode aparecer aqui.
#
# Gerar segredos fortes:
#   openssl rand -base64 48
# =============================================================================

# -----------------------------------------------------------------------------
# BANCO DE DADOS
# -----------------------------------------------------------------------------
# Usuário de RUNTIME da aplicação. Deve ter apenas SELECT/INSERT/UPDATE/DELETE
# nas tabelas da aplicação — SEM permissão de DDL (CREATE/ALTER/DROP).
# `connection_limit` dimensiona o pool do Prisma por processo Node.
DATABASE_URL="postgresql://discipular_app:TROQUE_ESTA_SENHA@localhost:5432/discipular?schema=public&connection_limit=10&pool_timeout=20&sslmode=prefer"

# Usuário de MIGRATION, separado do runtime. Este sim tem DDL.
# Usado só por `prisma migrate deploy` no deploy, nunca pela aplicação rodando.
DIRECT_DATABASE_URL="postgresql://discipular_migrator:TROQUE_ESTA_SENHA@localhost:5432/discipular?schema=public&sslmode=prefer"

# -----------------------------------------------------------------------------
# SEGREDOS DA APLICAÇÃO  (obrigatórios — o app se recusa a subir sem eles)
# -----------------------------------------------------------------------------
# Chave usada para derivar o hash dos tokens de sessão guardados no banco.
# Trocar esta chave desloga TODO MUNDO (é o botão de pânico de sessão).
# Mínimo 32 bytes em base64.
SESSION_SECRET="GERE_COM_openssl_rand_base64_48"

# Chave de criptografia simétrica (AES-256-GCM) para segredos por tenant
# guardados no banco (ex.: chave PIX, tokens de integração).
# Mínimo 32 bytes em base64. Perder esta chave torna os dados ilegíveis.
ENCRYPTION_KEY="GERE_COM_openssl_rand_base64_32"

# Segredo do token CSRF (double-submit assinado).
CSRF_SECRET="GERE_COM_openssl_rand_base64_32"

# -----------------------------------------------------------------------------
# APLICAÇÃO
# -----------------------------------------------------------------------------
NODE_ENV="development"

# Domínio raiz da plataforma. Subdomínios viram tenants automaticamente:
#   minhaigreja.discipular.app -> tenant "minhaigreja"
ROOT_DOMAIN="discipular.app"

# URL canônica do painel da plataforma (super admin e login central).
APP_URL="http://localhost:3000"

# Porta do processo Node (o Nginx faz proxy reverso para cá).
PORT="3000"

# Quantos proxies confiáveis existem na frente do app.
# Com Nginx local = 1. Com Cloudflare + Nginx = 2.
# Isso define de qual posição do X-Forwarded-For lemos o IP real do cliente.
# Errar este número permite que um atacante forje o IP e burle o rate limit.
TRUSTED_PROXY_HOPS="1"

# -----------------------------------------------------------------------------
# ARMAZENAMENTO DE ARQUIVOS
# -----------------------------------------------------------------------------
# Diretório PRIVADO, FORA da pasta public/. Arquivos só saem por rota
# autenticada que valida o tenant (/api/arquivos/[id]).
STORAGE_DIR="/var/lib/discipular/storage"

# Limite por arquivo, em bytes (5 MB).
MAX_UPLOAD_BYTES="5242880"

# -----------------------------------------------------------------------------
# INTEGRAÇÕES
# -----------------------------------------------------------------------------
# Chave do YouTube Data API v3 — usada SOMENTE no servidor para checar se o
# canal da igreja está ao vivo. NUNCA prefixar com NEXT_PUBLIC_.
# Restrinja a chave no Google Cloud Console por IP do servidor e por API.
YOUTUBE_API_KEY=""

# Intervalo (segundos) do cache da checagem de live. Protege sua cota da API.
YOUTUBE_LIVE_CACHE_SECONDS="60"

# -----------------------------------------------------------------------------
# WHATSAPP (uazapi) — conexão de número e automações
# -----------------------------------------------------------------------------
# Base URL da conta uazapi. Padrão: plano grátis. Troque pelo seu servidor pago
# se tiver um (ex.: https://SEU-SUBDOMINIO.uazapi.com).
UAZAPI_BASE_URL="https://free.uazapi.com"
# Admin token da conta uazapi — CHAVE-MESTRA. Fica SÓ aqui, no servidor, nunca
# no navegador. Sem ele a aba WhatsApp aparece mas informa que não foi ativada.
UAZAPI_ADMIN_TOKEN=""

# -----------------------------------------------------------------------------
# E-MAIL (SMTP) — recuperação de senha e notificações
# -----------------------------------------------------------------------------
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="Discipular <nao-responda@exemplo.com.br>"

# -----------------------------------------------------------------------------
# OBSERVABILIDADE
# -----------------------------------------------------------------------------
# debug | info | warn | error
LOG_LEVEL="info"

# =============================================================================
# NÃO ADICIONE VARIÁVEIS NEXT_PUBLIC_* COM SEGREDO.
# Tudo com prefixo NEXT_PUBLIC_ é embutido no bundle JavaScript e fica
# visível para qualquer visitante do site. Só use para valores realmente
# públicos (ex.: um ID de analytics).
# =============================================================================
